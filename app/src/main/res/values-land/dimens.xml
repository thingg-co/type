<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: height is scarce (a 1080px screen loses ~144px to the nav bar), so keys,
     gaps and the strip all shrink; portrait keeps its comfortable sizes. Around 28dp keys
     with 2dp gaps the whole keyboard sits near 40% of the screen, in Gboard's range. -->
<resources>
    <dimen name="kb_key_height">28dp</dimen>
    <dimen name="kb_row_gap">2dp</dimen>
    <dimen name="kb_key_gap">3dp</dimen>
    <dimen name="kb_bottom_padding">2dp</dimen>
    <dimen name="kb_key_text">16sp</dimen>
    <dimen name="kb_key_text_small">12sp</dimen>
    <dimen name="kb_strip_height">22dp</dimen>
</resources>
